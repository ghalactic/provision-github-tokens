{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": false,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "printWidth": 80,
        "proseWrap": "always"
      }
    }
  ],
  "ignorePatterns": [
    "/dist/",
    "/out/",
    "/pnpm-lock.yaml",
    "/src/schema/generated.*",
    "testdata/"
  ]
}
